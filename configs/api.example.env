# ==============================================================================
# isdict API Configuration
# ==============================================================================
# Copy this file to configs/api.env and modify the values according to your environment.
# Export ISDICT_API_ENV_FILE=configs/api.env when you want the application to load it.
# This template uses placeholder values for a managed PostgreSQL deployment.
# Update every credential before use.

# ==============================================================================
# Database Configuration
# ==============================================================================
DB_HOST=db.example.com
DB_PORT=5432
DB_USER=isdict_app
DB_PASSWORD=change-me
DB_NAME=isdict
# SSL mode: disable, allow, prefer, require, verify-ca, verify-full
# prefer (default): try SSL, fallback to non-SSL if unavailable
# require: typical baseline for managed PostgreSQL services
DB_SSLMODE=require

# Database Connection Pool Settings
# Maximum number of idle connections in the pool
DB_MAX_IDLE_CONNS=10
# Maximum number of open connections to the database
DB_MAX_OPEN_CONNS=100

# ==============================================================================
# Server Configuration
# ==============================================================================
# Server port
PORT=8080

# Gin mode: "debug", "release", or "test"
# - debug: verbose logging, helpful for development
# - release: optimized for production, minimal logging
# - test: for running tests
GIN_MODE=debug

# ==============================================================================
# Logging Configuration
# ==============================================================================
# Log level: debug, info, warn, error
# If unset in runtime, the application defaults to:
# - debug when GIN_MODE=debug or test
# - info when GIN_MODE=release
# Leave LOG_LEVEL unset to use the runtime default above.
# Example: set LOG_LEVEL=debug to force verbose development logs.
# LOG_LEVEL=

# Log output target: stdout or file
# - stdout: default for local development and test environments
# - file: write logs to LOG_FILE_PATH with rotation enabled
# Keep LOG_OUTPUT=stdout to send logs to standard output.
# To enable file logging, set LOG_OUTPUT=file and provide LOG_FILE_PATH.
LOG_OUTPUT=stdout

# Log file path (required only when LOG_OUTPUT=file)
# Example production path: /var/log/isdict-api/app.log
# Leave empty when LOG_OUTPUT=stdout.
LOG_FILE_PATH=

# File rotation settings (used only when LOG_OUTPUT=file)
# Maximum size of a single log file before rotation, in MB
LOG_MAX_SIZE_MB=100

# Maximum number of rotated log files to keep
LOG_MAX_BACKUPS=7

# Maximum age of rotated log files to keep, in days
LOG_MAX_AGE_DAYS=30

# ==============================================================================
# API Limits Configuration
# ==============================================================================
# Maximum number of words allowed in a single batch request
# Prevents excessive memory usage and slow responses
API_BATCH_MAX_SIZE=100

# Maximum number of search results that can be requested
# Controls the 'limit' parameter upper bound for search endpoints
API_SEARCH_MAX_LIMIT=100

# Maximum number of autocomplete suggestions that can be requested
# Controls the 'limit' parameter upper bound for suggest endpoints
API_SUGGEST_MAX_LIMIT=50

# ==============================================================================
# Middleware Configuration
# ==============================================================================

# --- Rate Limiting ---
# Enable or disable rate limiting middleware
ENABLE_RATE_LIMIT=true

# Requests per second (RPS) using token bucket algorithm
# Controls instant spike protection
RATE_LIMIT_RPS=100
# Burst size - allows temporary bursts above RPS
RATE_LIMIT_BURST=200

# Hourly rate limit (0 = disabled)
# Maximum requests allowed per hour per IP
RATE_LIMIT_PER_HOUR=10000

# Daily rate limit (0 = disabled)
# Maximum requests allowed per day per IP
RATE_LIMIT_PER_DAY=0

# --- CORS (Cross-Origin Resource Sharing) ---
# Enable CORS middleware
ENABLE_CORS=true

# Allowed origins (comma-separated, use "*" for all origins)
# Production example: https://example.com,https://app.example.com
# Development: use "*" for all origins
CORS_ALLOW_ORIGINS=*

# --- Request Timeout ---
# Enable request timeout middleware
ENABLE_TIMEOUT=true

# Timeout duration in seconds
# Requests exceeding this duration will be cancelled
TIMEOUT_SECONDS=30

# --- Request ID ---
# Enable request ID middleware for request tracing
# Adds X-Request-ID header to all requests/responses
ENABLE_REQUEST_ID=true

# --- Response Cache ---
# Enable response caching for GET requests
ENABLE_CACHE=true

# Maximum number of cached responses
CACHE_MAX_SIZE=1000

# Cache expiration time in minutes
CACHE_EXPIRATION_MINS=5

# ==============================================================================
# Notes
# ==============================================================================
# - Restart the server after changing any configuration values
# - For production deployments, use GIN_MODE=release
# - Adjust connection pool sizes based on your database capacity and load
# - API limits prevent abuse and ensure consistent performance
